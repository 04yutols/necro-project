# ─── このファイルを .env.local にコピーして値を記入する ───────────────────────
# cp .env.local.example .env.local

# ─── NextAuth ────────────────────────────────────────────────────────────────
# openssl rand -base64 32 で生成
AUTH_SECRET=""

# ─── Neon PostgreSQL ─────────────────────────────────────────────────────────
# Neon ダッシュボード → プロジェクト → Connection string から取得
# 必ず ?sslmode=require を含める
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# ─── 管理画面 AI 草案エージェント（開発専用）──────────────────────────────────
# バックエンド選択: vertex（GCP課金クォータ・推奨） / aistudio（APIキー無料枠）
GEMINI_BACKEND="vertex"
# vertex の場合: GCP プロジェクトと ADC が必要
#   gcloud auth application-default login を実行しておくこと
GOOGLE_CLOUD_PROJECT="your-gcp-project-id"
GOOGLE_CLOUD_REGION="us-central1"
# aistudio の場合: Google AI Studio の API キー
GEMINI_API_KEY=""
