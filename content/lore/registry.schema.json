{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://necromance-brave.local/schemas/lore-registry-v1.json",
  "title": "Necromance Brave Lore Registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "updatedAt", "entries", "relationships", "timeline"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "updatedAt": { "type": "string", "format": "date-time" },
    "entries": { "type": "array", "items": { "$ref": "#/$defs/entry" } },
    "relationships": { "type": "array", "items": { "$ref": "#/$defs/relationship" } },
    "timeline": { "type": "array", "items": { "$ref": "#/$defs/timeline" } }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
    "text": { "type": "string", "minLength": 1 },
    "certainty": { "enum": ["CONFIRMED", "PROVISIONAL", "REJECTED"] },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "certainty", "nameJa", "aliases", "summary", "chapterIntroduced", "sourceRefs", "tags"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "kind": { "enum": ["CHARACTER", "PLACE", "FACTION", "EVENT", "ARTIFACT", "CONCEPT"] },
        "certainty": { "$ref": "#/$defs/certainty" },
        "nameJa": { "$ref": "#/$defs/text" },
        "nameEn": { "$ref": "#/$defs/text" },
        "aliases": { "type": "array", "items": { "type": "string" } },
        "summary": { "$ref": "#/$defs/text" },
        "chapterIntroduced": { "type": "integer", "minimum": 0 },
        "sourceRefs": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/text" } },
        "tags": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/text" } }
      }
    },
    "relationship": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "from", "to", "type", "certainty", "summary", "sourceRefs"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "from": { "$ref": "#/$defs/id" },
        "to": { "$ref": "#/$defs/id" },
        "type": { "$ref": "#/$defs/text" },
        "certainty": { "$ref": "#/$defs/certainty" },
        "summary": { "$ref": "#/$defs/text" },
        "sourceRefs": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/text" } }
      }
    },
    "timeline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "order", "chapter", "title", "summary", "participantRefs", "certainty", "sourceRefs"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "order": { "type": "number" },
        "chapter": { "type": "integer", "minimum": 0 },
        "title": { "$ref": "#/$defs/text" },
        "summary": { "$ref": "#/$defs/text" },
        "participantRefs": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/id" } },
        "locationRef": { "$ref": "#/$defs/id" },
        "certainty": { "$ref": "#/$defs/certainty" },
        "sourceRefs": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/text" } }
      }
    }
  }
}
